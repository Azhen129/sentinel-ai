# The default application is a synthetic replay. No capture or scanning is performed.
SENTINEL_LAB_MODE=false
SENTINEL_PCAP_ENABLED=false
# Separate local Windows metadata profile; mutually exclusive with lab mode.
# Off by default. Enabling this API profile never starts a capture process.
SENTINEL_MONITOR_MODE=false
# Frozen, synthetic-only public showcase; requires its own dedicated database.
SENTINEL_PUBLIC_DEMO=false
# Set a long random secret before enabling local lab ingestion; never commit a real key.
SENTINEL_API_KEY=
# SQLite state belongs on a local persistent volume, outside the Git index.
SENTINEL_DB_PATH=data/sentinel.db
# Use data/lab.db for authorized lab mode. Demo startup rejects a database containing lab data.
# For monitor mode choose a NEW dedicated path, for example:
# SENTINEL_DB_PATH=data/monitoring/windows-monitor.db
# Never reuse the default demo database, a lab database, or an unmarked existing file.
# The default monitor row cap is 5000 (application factory argument, not an environment variable).
# Used by local development only. Docker nginx proxies /api to the backend.
SENTINEL_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Separate monitor example: backend 127.0.0.1:8004, frontend 127.0.0.1:5176.
# SENTINEL_CORS_ORIGINS=http://127.0.0.1:5176
# Set frontend VITE_API_PROXY_TARGET=http://127.0.0.1:8004 in its own terminal.
# Keep VITE_API_BASE blank for that same-origin proxy; never expose keys through VITE_.
