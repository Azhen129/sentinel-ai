# PUBLIC frontend configuration. VITE_ values are embedded in browser JavaScript.
# Never put an ingestion API key, password, or other secret here.
# Leave blank to use the local Vite/Compose /api proxy.
VITE_API_BASE=
# Local development proxy only. Literal loopback HTTP(S) origin, no API key.
# Use http://127.0.0.1:8004 for the separate local monitor profile.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
